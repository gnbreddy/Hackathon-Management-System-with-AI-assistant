# ==========================================
# EHub Environment Variables Template
# Copy to .env and replace with your credentials
# (Do NOT commit .env files to GitHub!)
# ==========================================

# --- Backend Configuration ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ehub_db
SPRING_DATASOURCE_USERNAME=ehub_user
SPRING_DATASOURCE_PASSWORD=ehub_password
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (HMAC-SHA256 256-bit string)
APPLICATION_SECURITY_JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Mail / OTP Dispatch (Optional - dev logs OTP to console automatically)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Allowed CORS Origins
APPLICATION_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend Configuration ---
VITE_API_URL=/api
